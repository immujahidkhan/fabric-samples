# Environment variables for BISL Proof Transparency RPC
# Copy to .env or export in your shell before `npm start`

PORT=4000

# Required in production (auth is ON by default)
# Generate with: openssl rand -hex 32
WRITE_API_KEY=change-me-write-key
READ_API_KEY=change-me-read-key

# Optional alias: if WRITE_API_KEY is unset, API_KEY is used for writes
# API_KEY=change-me-write-key

# Set to false only for local development without keys
REQUIRE_AUTH=true

# Fabric identity used by the RPC (clients cannot override this)
FABRIC_ORG=org1
FABRIC_IDENTITY=appUserOrg1

# Path to fabric folder (VPS package: ../fabric). Dev default uses fabric-samples root.
# FABRIC_ROOT=../fabric

# Set false when peers use public hostnames (remote Fabric)
DISCOVERY_AS_LOCALHOST=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
