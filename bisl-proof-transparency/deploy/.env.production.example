PORT=4000

# Generate: openssl rand -hex 32
WRITE_API_KEY=change-me-write-key
READ_API_KEY=change-me-read-key

REQUIRE_AUTH=true

# VPS package layout (set automatically by .env.vps)
FABRIC_ROOT=../fabric
DISCOVERY_AS_LOCALHOST=true

FABRIC_ORG=org1
FABRIC_IDENTITY=appUserOrg1
CHANNEL_NAME=mychannel
CHAINCODE_NAME=bislcc

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
